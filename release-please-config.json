{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": true,
  "separate-pull-requests": true,
  "bootstrap-sha": "2ada5e786ac01d6becc03948e3715b85017007ee",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance Improvements" },
    { "type": "refactor", "section": "Code Refactoring" },
    { "type": "docs", "section": "Documentation" },
    { "type": "revert", "section": "Reverts" },
    { "type": "chore", "section": "Miscellaneous Chores", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build System", "hidden": true },
    { "type": "ci", "section": "Continuous Integration", "hidden": true },
    { "type": "style", "section": "Styles", "hidden": true }
  ],
  "packages": {
    ".": {
      "component": "marketplace",
      "package-name": "superhuman-marketplace",
      "changelog-path": "CHANGELOG.md",
      "pull-request-title-pattern": "chore(marketplace): release ${version}",
      "exclude-paths": [
        "plugins"
      ],
      "extra-files": [
        {
          "type": "json",
          "path": ".claude-plugin/marketplace.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "plugins/gilbreth": {
      "component": "gilbreth",
      "package-name": "gilbreth",
      "changelog-path": "CHANGELOG.md",
      "pull-request-title-pattern": "chore(gilbreth): release ${version}",
      "extra-files": [
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "/.claude-plugin/marketplace.json",
          "jsonpath": "$.plugins[?(@.name==\"gilbreth\")].version"
        }
      ]
    }
  }
}
